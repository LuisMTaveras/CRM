VITE_API_URL=http://localhost:3002/api
VITE_USE_MOCK=true
# País para locale, moneda y formato telefónico (DO, US, PR, CO, MX, ES, CL, PE, AR)
VITE_FORMAT_COUNTRY=DO

# Servidor unificado de correo + WhatsApp
PORT=3002
EMAIL_PORT=3002
# Interfaz de escucha: 127.0.0.1 (solo local) o 0.0.0.0 (red local, usar con precaución)
HOST=127.0.0.1
# Orígenes permitidos por CORS, separados por coma
CRM_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Solo habilitar si el servidor de correo usa un certificado autofirmado
EMAIL_TLS_INSECURE=false

# Configuración PostgreSQL (para persistencia externa)
PGHOST=localhost
PGPORT=5432
PGDATABASE=crm_db
PGUSER=postgres
PGPASSWORD=postgres
