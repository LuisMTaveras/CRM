VITE_API_URL=http://localhost:3002/api
# true solo para desarrollo local/demo. En producci��n usa false para exigir login backend.
VITE_USE_MOCK=true
# Semilla opcional del modo local/demo. Sin estas variables no se crea ningun usuario demo.
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=
VITE_DEMO_ADMIN_NOMBRE=Administrador Demo
VITE_DEMO_ADMIN_ROL=admin
VITE_DEMO_ADMIN_ROL_NOMBRE=Administrador
VITE_DEMO_ADMIN_CARGO=Administraci��n
VITE_DEMO_ADMIN_DEPARTAMENTO=Direcci��n
VITE_DEMO_ADMIN_TELEFONO=
# País para locale, moneda y formato telefónico (DO, US, PR, CO, MX, ES, CL, PE, AR)
VITE_FORMAT_COUNTRY=DO

# Servidor unificado de correo + WhatsApp
PORT=3002
EMAIL_PORT=3002
# Interfaz de escucha: 127.0.0.1 (solo local) o 0.0.0.0 (red local, usar con precaución)
HOST=127.0.0.1
# Orígenes permitidos por CORS, separados por coma
CRM_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Solo habilitar si el servidor de correo usa un certificado autofirmado
EMAIL_TLS_INSECURE=false
# Por defecto se bloquean SMTP/IMAP en localhost y redes privadas (protección SSRF).
# Activar solo en desarrollo con un servidor de correo local confiable.
EMAIL_ALLOW_PRIVATE_HOSTS=false

# Autenticación del API
# En producción es obligatoria. En desarrollo queda desactivada salvo que se fuerce.
# CRM_REQUIRE_AUTH=true
# Genera el secreto con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CRM_SESSION_SECRET=
CRM_SESSION_TTL_MINUTES=480
# Alternativa para scripts/servicios: clave enviada en x-api-key. No usar en el frontend.
# CRM_API_KEY=
# Usuario administrador inicial. Solo se crea si el archivo de usuarios no existe o está vacío.
CRM_ADMIN_EMAIL=
CRM_ADMIN_PASSWORD=
CRM_ADMIN_NOMBRE=Administrador
CRM_ADMIN_TELEFONO=
# Ruta opcional del archivo de usuarios. Por defecto: server/data/usuarios.json
# CRM_USERS_FILE=
# Ruta y tamaño máximo del registro de auditoría. Por defecto: server/data/auditoria.json
# CRM_AUDIT_FILE=
CRM_AUDIT_MAX_EVENTS=5000

# Configuración PostgreSQL (para persistencia externa)
PGHOST=localhost
PGPORT=5432
PGDATABASE=crm_db
PGUSER=postgres
PGPASSWORD=postgres
